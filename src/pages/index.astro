---
import Layout from '../layouts/Layout.astro';

const email = 'clement@charterwise.app';

const services = [
  {
    title: 'A readiness assessment',
    body: 'A short, practical look at where your time is actually going, and where AI or better process could realistically help.',
  },
  {
    title: 'Implementation support',
    body: 'Hands-on help actually putting a change into practice, not just a report.',
  },
  {
    title: 'Ongoing advice',
    body: "Light, continuing support once things are running, for as long as it's useful.",
  },
];
---

<Layout>
  <main class="max-w-2xl mx-auto px-6">
    <section class="hero-wash -mx-6 px-6 pt-20 pb-16 sm:pt-28 sm:pb-20">
      <div class="fade-up">
        <h1 class="font-serif text-4xl sm:text-5xl font-medium tracking-tight leading-[1.1] mb-5">
          Operational and AI guidance for charter fleet operators
        </h1>
        <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed mb-8 max-w-md">
          I help small, independent charter companies find where AI and better process can
          realistically save time, and put it into practice without disrupting how you already
          run things.
        </p>
        <a
          href={`mailto:${email}`}
          class="group inline-flex items-center gap-2 rounded-md bg-[var(--color-clay)] text-white px-5 py-3 font-medium shadow-[0_1px_2px_rgba(28,28,26,0.08)] hover:bg-[var(--color-clay-dark)] hover:shadow-[0_6px_16px_rgba(191,107,69,0.3)] hover:-translate-y-0.5 transition-all duration-200"
        >
          Get in touch
          <span class="transition-transform duration-200 group-hover:translate-x-0.5">&rarr;</span>
        </a>
      </div>
    </section>

    <div class="py-14 sm:py-20">
      <section class="reveal mb-16">
        <p class="text-sm font-medium uppercase tracking-wide text-[var(--color-clay-dark)]">
          Who this is for
        </p>
        <p class="font-serif text-xl mt-2">
          For small, independent and family run charter fleet operators.
        </p>
      </section>

      <section class="reveal mb-16 border-l-2 border-[var(--color-clay)] pl-6">
        <p class="font-serif italic text-xl sm:text-2xl leading-snug text-[var(--color-ink)]">
          A lot of operators are buried in the day to day: bookings, handovers, admin. There's
          rarely time left for the parts of the business that actually matter.
        </p>
        <p class="mt-3 text-[var(--color-text-secondary)]">
          Most sense AI could help somewhere, but not exactly where to point it.
        </p>
      </section>

      <section class="reveal mb-16">
        <h2 class="font-serif text-2xl mb-8">What I help with</h2>
        <ul class="space-y-7">
          {services.map((service, i) => (
            <li class="flex gap-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-full border border-[var(--color-clay)] text-[var(--color-clay-dark)] text-sm font-medium flex items-center justify-center mt-0.5">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <p class="font-medium">{service.title}</p>
                <p class="text-[var(--color-text-secondary)]">{service.body}</p>
              </div>
            </li>
          ))}
        </ul>
        <p class="text-sm text-[var(--color-text-secondary)] italic mt-8">
          Scoped to what the business actually needs right now, not a full-time commitment.
        </p>
      </section>

      <section class="reveal mb-16">
        <h2 class="font-serif text-2xl mb-6">About</h2>
        <div class="sm:flex sm:gap-6">
          <img
            src="/clement.jpg"
            alt="Clement Toulemonde"
            width="410"
            height="600"
            class="w-28 h-36 object-cover object-top rounded-md mb-4 sm:mb-0 sm:flex-shrink-0 ring-1 ring-[var(--color-border)]"
          />
          <div>
            <p class="leading-relaxed mb-4">
              I spent over 15 years leading operations teams at Google and Meta. The last several
              years were spent finding where AI could take repetitive, manual work off people's
              plates, and proving it actually saved time rather than just adding another tool to
              the pile.
            </p>
            <p class="leading-relaxed mb-4">
              Charter operators face a smaller version of the same problem: too much time going
              into bookings, handovers, and admin, not enough left for the parts of the business
              that matter. I help figure out where AI and better process can realistically help,
              and how to put that into practice without disrupting how you already run things.
            </p>
            <a
              href="https://linkedin.com/in/clementtoulemonde"
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-[var(--color-clay)] hover:text-[var(--color-clay-dark)]"
            >
              Connect on LinkedIn
            </a>
          </div>
        </div>
      </section>

      <section class="reveal mb-4">
        <h2 class="font-serif text-2xl mb-4">How a first call works</h2>
        <p class="leading-relaxed">
          If this sounds useful, the first step is just a conversation, not a pitch. We talk
          through what your day to day actually looks like, and whether there's anything concrete
          I could help with. No cost, no obligation either way.
        </p>
      </section>
    </div>

    <footer class="py-10 border-t border-[var(--color-border)] text-sm text-[var(--color-text-secondary)]">
      <p class="mb-2">
        <a href={`mailto:${email}`} class="text-[var(--color-clay)] hover:text-[var(--color-clay-dark)]">
          {email}
        </a>
      </p>
      <p>This is Clement's independent consulting practice, separate from the CharterWise app.</p>
    </footer>
  </main>
</Layout>

<script>
  const revealEls = document.querySelectorAll('.reveal');
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
  );
  revealEls.forEach((el) => io.observe(el));
</script>
