---
import Layout from '../layouts/Layout.astro';

const email = 'clement@charterwise.app';

const steps = [
  {
    title: 'A readiness assessment',
    body: 'A short, practical look at where your time is actually going, and where AI or better process could realistically help. Delivered as a short written plan within a week of our call.',
  },
  {
    title: 'Implementation support',
    body: 'Hands-on help actually putting a change into practice, not just a report.',
  },
  {
    title: 'Ongoing advice',
    body: "Light, continuing support once things are running, for as long as it's useful.",
  },
];
---

<Layout>
  <div class="max-w-4xl mx-auto px-6">
    <header
      id="site-header"
      data-scrolled="false"
      class="sticky top-0 z-50 w-full flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-8 border-b border-[var(--color-hairline)] bg-[var(--color-ground)]"
    >
      <div class="flex items-center gap-3">
        <svg
          class="h-6 w-auto shrink-0"
          viewBox="68 20 700 424"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            fill="var(--color-primary)"
            d="M418.188 79C526.188 79 646.188 49 708.188 33C735.79 25.88 761.05 53.08 762.7 81.5C764.35 109.92 741.33 127.25 714.188 136C652.188 156 612.188 194 610.188 256C610.188 288 624.188 312 642.188 328C658.188 344 678.188 354 694.188 360C708.188 366 714.188 380 714.188 398C714.188 414 714.188 426 714.188 432C714.188 440 122.188 440 122.188 432C122.188 426 122.188 414 122.188 398C122.188 380 128.188 366 142.188 360C158.188 354 178.188 344 194.188 328C212.188 312 226.188 288 226.188 256C224.188 194 184.188 156 122.188 136C95.046 127.25 72.026 109.92 73.676 81.5C75.326 53.08 100.586 25.88 128.188 33C190.188 49 310.188 79 418.188 79ZM387.188 196H449.188C469.188 196 485.188 212 485.188 232V320C485.188 340 469.188 356 449.188 356H387.188C367.188 356 351.188 340 351.188 320V232C351.188 212 367.188 196 387.188 196Z"
          ></path>
        </svg>
        <div class="sm:flex sm:items-baseline sm:gap-3">
          <span class="font-display text-xl text-[var(--color-ink)]">CharterWise Consulting</span>
          <span class="hidden sm:inline text-[var(--color-hairline)]">|</span>
          <span class="text-sm text-[var(--color-muted)]">Clement Toulemonde</span>
        </div>
      </div>
      <nav class="flex items-center gap-6 text-sm shrink-0">
        <a href="#how-i-work" class="text-[var(--color-ink)] hover:text-[var(--color-primary)] transition-colors">How I work</a>
        <a
          href={`mailto:${email}`}
          class="text-[var(--color-accent-ink)] underline decoration-[var(--color-accent)] decoration-2 underline-offset-4 hover:text-[var(--color-primary)] transition-colors"
        >Book a call</a>
      </nav>
    </header>

    <section class="grid sm:grid-cols-[1fr_220px] gap-10 py-16 sm:py-20">
      <div class="max-w-[65ch]" data-reveal>
        <p class="font-text text-sm font-semibold text-[var(--color-accent-ink)] mb-4">
          Independent advisor for charter operators
        </p>
        <h1 class="font-display text-4xl sm:text-5xl font-medium leading-[1.15] mb-6">
          Practical help with AI and operations, for
          <span class="sage-underline">charter companies</span>.
        </h1>
        <p class="text-lg text-[var(--color-ink)] leading-relaxed mb-8">
          I work with operators running a handful to a few dozen yachts: finding where the
          season's time goes, what's worth automating, and what's better left alone.
        </p>
        <div class="flex flex-wrap items-center gap-6 mb-6">
          <a
            href={`mailto:${email}`}
            class="inline-block rounded-[var(--radius-md)] bg-[linear-gradient(135deg,var(--color-primary),var(--color-primary-hover))] text-[var(--color-on-primary)] px-5 py-3 font-text font-semibold text-[15px] shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-[box-shadow,transform] duration-200"
          >
            Book a 30-minute call
          </a>
          <a href="#how-i-work" class="text-sm text-[var(--color-ink)] underline decoration-[var(--color-hairline)] underline-offset-4 hover:text-[var(--color-primary)] transition-colors">
            How I work
          </a>
        </div>
        <p class="text-sm text-[var(--color-muted)]">
          This isn't for operators who already have a dedicated ops or tech team. It's for the
          ones who don't, and don't have time to figure this out alone.
        </p>
      </div>
      <aside
        class="rounded-[var(--radius-md)] border border-[var(--color-hairline)] bg-[var(--color-surface)] p-5 shadow-sm transition-[box-shadow,transform] duration-300 hover:shadow-md hover:-translate-y-1"
        data-reveal
        style="--reveal-delay: 150ms;"
      >
        <div class="w-6 h-0.5 bg-[var(--color-accent)] mb-3" data-reveal-rule style="--reveal-delay: 450ms;"></div>
        <p class="font-display italic text-base text-[var(--color-muted)] leading-snug">
          Advice by call, then a written plan you keep, whether or not we carry on together.
        </p>
      </aside>
    </section>

    <section id="how-i-work" class="grid sm:grid-cols-[1fr_220px] gap-10 py-14 border-t border-[var(--color-hairline)]">
      <div class="max-w-[65ch]" data-reveal>
        <h2 class="font-display text-2xl mb-8">How I work</h2>
        <ol class="grid gap-4">
          {steps.map((step, i) => (
            <li
              class="rounded-[var(--radius-md)] border border-[var(--color-hairline)] bg-[var(--color-surface)] p-6 shadow-sm transition-[box-shadow,transform] duration-300 hover:shadow-md hover:-translate-y-1"
              data-reveal
              style={`--reveal-delay: ${i * 120}ms;`}
            >
              <div class="w-6 h-0.5 bg-[var(--color-primary)] mb-4" data-reveal-rule style={`--reveal-delay: ${i * 120 + 200}ms;`}></div>
              <p class="font-text font-semibold mb-1">{step.title}</p>
              <p class="text-[var(--color-muted)] max-w-[60ch]">{step.body}</p>
            </li>
          ))}
        </ol>
        <p class="font-display italic text-sm text-[var(--color-muted)] mt-8">
          Scoped to what the business actually needs right now, not a full-time commitment.
        </p>
      </div>
      <aside
        class="rounded-[var(--radius-md)] border border-[var(--color-hairline)] bg-[var(--color-surface)] p-5 shadow-sm transition-[box-shadow,transform] duration-300 hover:shadow-md hover:-translate-y-1"
        data-reveal
        style="--reveal-delay: 150ms;"
      >
        <p class="font-text text-sm font-semibold text-[var(--color-accent-ink)] mb-3">
          Example
        </p>
        <p class="font-display italic text-base text-[var(--color-muted)] leading-snug">
          At ICE Amsterdam, the same question kept coming up: a guest wants to know, before they
          book, whether tables and linens are included, or whether an extra like a paddleboard
          has been confirmed. Answered in minutes, that question turns into a booking. Left for
          a day, it often doesn't.
        </p>
      </aside>
    </section>

    <section class="grid sm:grid-cols-[1fr_220px] gap-10 py-14 border-t border-[var(--color-hairline)]">
      <div class="max-w-[65ch]" data-reveal>
        <h2 class="font-display text-2xl mb-6">About</h2>
        <div class="sm:flex sm:gap-6">
          <img
            src="/clement.jpg"
            alt="Clement Toulemonde"
            width="410"
            height="600"
            class="w-32 h-44 sm:w-40 sm:h-56 object-cover object-top rounded-[var(--radius-md)] border border-[var(--color-hairline)] shadow-md mb-4 sm:mb-0 sm:flex-shrink-0 transition-transform duration-300 hover:scale-[1.03]"
          />
          <div>
            <p class="leading-relaxed mb-4">
              I'm a sailor. I hold RYA qualifications including a cross-ocean passage, and I've
              chartered boats myself across the Mediterranean and beyond, over 5,800 nautical
              miles logged, mostly with family and friends.
            </p>
            <p class="leading-relaxed mb-4">
              I've also spent over 15 years leading operations teams at Google and Meta,
              including years finding where AI could take repetitive, manual work off people's
              plates, and proving it actually saved time rather than just adding another tool to
              the pile.
            </p>
            <p class="leading-relaxed mb-4">
              That combination is the actual point. I've been the charterer dealing with a bad
              handover, and I've been the person inside a large operation figuring out where AI
              genuinely helps rather than just sounding impressive. Charter operators face a
              smaller version of the same problem: too much time going into bookings, handovers,
              and admin, not enough left for the parts of the business that matter. I help figure
              out where AI and better process can realistically help, and how to put that into
              practice without disrupting how you already run things.
            </p>
            <a
              href="https://linkedin.com/in/clementtoulemonde"
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-[var(--color-accent-ink)] underline decoration-[var(--color-accent)] decoration-2 underline-offset-4"
            >
              Connect on LinkedIn
            </a>
          </div>
        </div>
      </div>
      <aside
        class="rounded-[var(--radius-md)] border border-[var(--color-hairline)] bg-[var(--color-surface)] p-5 shadow-sm transition-[box-shadow,transform] duration-300 hover:shadow-md hover:-translate-y-1"
        data-reveal
        style="--reveal-delay: 150ms;"
      >
        <div class="w-6 h-0.5 bg-[var(--color-accent)] mb-3" data-reveal-rule style="--reveal-delay: 450ms;"></div>
        <p class="font-display italic text-base text-[var(--color-muted)] leading-snug">
          If this sounds useful, the first step is just a conversation, not a pitch. No cost, no
          obligation either way.
        </p>
      </aside>
    </section>

    <footer class="py-10 border-t border-[var(--color-hairline)] text-sm text-[var(--color-muted)]" data-reveal>
      <p class="mb-2">
        <a href={`mailto:${email}`} class="text-[var(--color-accent-ink)] underline decoration-[var(--color-accent)] decoration-2 underline-offset-4">
          {email}
        </a>
      </p>
      <p>This is Clement's independent consulting practice, separate from the CharterWise app.</p>
    </footer>
  </div>
</Layout>
